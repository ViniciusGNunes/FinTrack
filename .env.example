# Backend Environment Variables Reference (.env / Hosting Provider Settings)
#
# In production hosts (e.g., Render, Railway, Azure, Docker), set these variables
# in the provider's Environment Variables dashboard.
# Note: In ASP.NET Core, nested JSON properties are mapped using double underscores `__`.

# Database Connection (Supabase, Neon, Railway Postgres, etc.)
ConnectionStrings__DefaultConnection="Host=your-db-host.supabase.com;Port=5432;Database=postgres;Username=postgres.youruser;Password=your_secure_password;SSL Mode=Require;Trust Server Certificate=true"

# JWT Authentication
Jwt__Secret="your-very-long-and-cryptographically-secure-secret-key-min-32-chars"
Jwt__Issuer="https://api.yourdomain.com"
Jwt__Audience="https://fintrack.yourdomain.com"
Jwt__ExpireMinutes="60"

# Hosted Frontend URL (Used for CORS and Email Confirmation / Password Reset links)
FrontendUrl="https://fintrack.yourdomain.com"

# Resend Email Service (For email confirmations and password resets)
Resend__ApiKey="re_your_live_resend_api_key"
Resend__FromEmail="FinTrack <onboarding@resend.dev>"

# Cookie Settings
CookieSettings__Name="X-Access-Token"
CookieSettings__ExpireTimeInMinutes="60"
CookieSettings__Secure="true"
CookieSettings__SameSite="Strict"
CookieSettings__HttpOnly="false"
